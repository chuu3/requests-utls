                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "padding"
                  },
                  "padding_length": {
                    "type": "integer",
                    "description": "Padding payload bytes on the wire; Peet padding_data_length instead counts hexadecimal characters and is divided by two on import.",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "required": [
                  "type",
                  "padding_length"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "record_size_limit"
                  },
                  "record_size_limit": {
                    "type": "integer",
                    "minimum": 64,
                    "maximum": 16385
                  }
                },
                "required": [
                  "type",
                  "record_size_limit"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "token_binding"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "minItems": 3,
                    "maxItems": 257
                  }
                },
                "required": [
                  "type",
                  "values"
                ]
              }
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "min_version",
        "max_version",
        "cipher_suites",
        "extensions"
      ]
