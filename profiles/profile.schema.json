            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stream_dep": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "exclusive": {
                "type": "boolean"
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              },
              "stream_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "stream_dep",
              "exclusive",
              "weight",
              "stream_id"
            ]
          },
          "description": "Captured initial PRIORITY frames retained as metadata; current transport does not emit them."
        }
      },
      "required": []
    },
    "http_version": {
      "enum": [
        "h2",
        "http/1.1"
      ],
      "description": "Captured HTTP protocol metadata; default h2. Does not change the captured ALPN unless ForceHTTP1 is explicitly selected."
    }
