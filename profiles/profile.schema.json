                        10,
                        11,
                        13,
                        16,
                        17,
                        18,
                        21,
                        23,
                        24,
                        27,
                        28,
                        34,
                        35,
                        41,
                        42,
                        43,
                        44,
                        45,
                        50,
                        51,
                        2570,
                        6682,
                        10794,
                        13172,
                        14906,
                        17513,
                        17613,
                        19018,
                        23130,
                        27242,
                        30031,
                        30032,
                        31354,
                        35466,
                        39578,
                        43690,
                        47802,
                        51914,
                        56026,
                        60138,
                        64250,
                        65037,
                        65281,
                        65486
