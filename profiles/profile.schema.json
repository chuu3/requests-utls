{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://requests-utls.local/profile.schema.json",
  "title": "requests-utls wire profile v1",
  "description": "Structural validation for immutable TLS wire profiles. The Go loader checks semantic consistency and reports advertisement-only algorithms and extension behavior.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_version": {
          "enum": [
            769,
            770,
            771,
            772
          ]
        },
        "max_version": {
          "enum": [
            769,
            770,
            771,
            772
          ]
        },
        "cipher_suites": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "minItems": 1,
          "maxItems": 32767
        },
        "extensions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "server_name"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "status_request"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "session_ticket"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "sct"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "extended_master_secret"
                  }
