                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "delegated_credentials"
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 65535
                    },
                    "minItems": 1
                  },
                  "allow_unsupported": {
                    "type": "boolean",
                    "description": "Explicit advertisement-only opt-in for signature schemes not implemented by uTLS."
                  }
                },
                "required": [
                  "type",
                  "values"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "npn"
                  },
                  "protocols": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "minItems": 1
