        "header_priority": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stream_dep": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "exclusive": {
              "type": "boolean"
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
